# ==============================================
# BACKEND - FastAPI
# ==============================================

# Database
DATABASE_URL=postgresql+asyncpg://contabil:contabil123@localhost:5432/contabil_db
DATABASE_WRITE_URL=postgresql+asyncpg://contabil:contabil123@localhost:5432/contabil_db
DATABASE_READ_URL=postgresql+asyncpg://contabil:contabil123@localhost:5432/contabil_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_DEV_ADMIN_BOOTSTRAP=true
DEV_ADMIN_EMAIL=admin@contabil.com
DEV_ADMIN_PASSWORD=admin123
DEV_ADMIN_NAME=Administrador Local

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/var/uploads

# Finance
# ID do "cliente do escritório" usado para lançamentos do financeiro do escritório
OFFICE_CLIENT_ID=522d5b00-2a4d-4f5a-8913-5d4ee0cf8104

# ==============================================
# FRONTEND - Next.js
# ==============================================

# API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://api:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# App
NEXT_PUBLIC_APP_NAME=SaaS Contábil
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OFFICE_CLIENT_ID=522d5b00-2a4d-4f5a-8913-5d4ee0cf8104

# ==============================================
# DATABASE - PostgreSQL
# ==============================================

POSTGRES_USER=contabil
POSTGRES_PASSWORD=contabil123
POSTGRES_DB=contabil_db
POSTGRES_PORT=5432

# ==============================================
# NGINX
# ==============================================

NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================
# DEVELOPMENT
# ==============================================

# Ports
WEB_PORT=3000
API_PORT=8000

# Logs
LOG_LEVEL=INFO
