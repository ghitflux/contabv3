# Environment
ENVIRONMENT=production
DEBUG=false

# Database PostgreSQL
DATABASE_URL=postgresql+asyncpg://contabil:SENHA_FORTE_AQUI@postgres:5432/contabil_db
DATABASE_WRITE_URL=postgresql+asyncpg://contabil:SENHA_FORTE_AQUI@postgres:5432/contabil_db
DATABASE_READ_URL=postgresql+asyncpg://contabil:SENHA_FORTE_AQUI@postgres:5432/contabil_db

POSTGRES_USER=contabil
POSTGRES_PASSWORD=SENHA_FORTE_AQUI
POSTGRES_DB=contabil_db
POSTGRES_PORT=5432

# Security (gerar chaves fortes com: openssl rand -hex 32)
SECRET_KEY=CHAVE_SECRETA_FORTE_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=https://cicgestao.com,https://www.cicgestao.com

# Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/var/uploads

# Finance
OFFICE_CLIENT_ID=522d5b00-2a4d-4f5a-8913-5d4ee0cf8104

# Frontend
NEXT_PUBLIC_API_URL=https://cicgestao.com/api
NEXT_PUBLIC_WS_URL=wss://cicgestao.com/ws
NEXT_PUBLIC_APP_NAME=CIC Gestão
NEXT_PUBLIC_APP_URL=https://cicgestao.com
NEXT_PUBLIC_OFFICE_CLIENT_ID=522d5b00-2a4d-4f5a-8913-5d4ee0cf8104

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
